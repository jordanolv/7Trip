# Copy to .env for local development (`docker compose up -d db` from the repo root).
DATABASE_URL="postgresql://seventrip:seventrip@localhost:5432/seventrip?schema=public"
PORT=3100

# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# `log` prints emails (and their codes) in the API console instead of sending them.
MAIL_TRANSPORT=log
# MAIL_TRANSPORT=smtp
# SMTP_URL="smtps://user:password@smtp.example.com:465"
# MAIL_FROM="7Trip <no-reply@7trip.fr>"
