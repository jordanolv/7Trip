// 7Trip data model. The full V1 model is described in docs/architecture.md §4 and is added
// domain by domain, step by step (docs/roadmap.md).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// Always stored normalised (trimmed, lower case).
  email           String    @unique
  displayName     String
  /// Argon2id hash. Null for accounts that only use Apple / Google sign-in.
  passwordHash    String?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens RefreshToken[]
  emailCodes    EmailCode[]
  participants  Participant[]
  invitations   Invitation[]
  createdTrips  Trip[]
}

/// Opaque refresh tokens, stored hashed. Each one is single use (rotation on refresh).
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum EmailCodePurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Six-digit codes sent by email. Short lived, limited attempts, stored hashed.
model EmailCode {
  id         String           @id @default(uuid(7)) @db.Uuid
  userId     String           @db.Uuid
  purpose    EmailCodePurpose
  codeHash   String
  attempts   Int              @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

enum TripKind {
  SOLO
  GROUP
}

enum InvitePolicy {
  ALL
  ORGANIZERS
}

/// A trip. Only a title is required: destination and dates can be decided later (CDC §4).
model Trip {
  id           String       @id @default(uuid(7)) @db.Uuid
  title        String
  startDate    DateTime?    @db.Date
  endDate      DateTime?    @db.Date
  kind         TripKind     @default(GROUP)
  /// Key of the identity colour (see TRIP_COLORS in @7trip/shared).
  color        String
  /// Key of the identity icon (see TRIP_ICONS in @7trip/shared).
  icon         String
  invitePolicy InvitePolicy @default(ALL)
  baseCurrency String       @default("EUR")
  createdById  String       @db.Uuid
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  createdBy    User              @relation(fields: [createdById], references: [id])
  participants Participant[]
  destinations TripDestination[]
  invitations  Invitation[]
  ideas        Idea[]
}

/// Group invitation link of a trip (7trip.fr/j/<code>). One active link per trip; renewing it
/// revokes the old one. Joining always gives the PARTICIPANT role (docs/architecture.md §5).
model Invitation {
  id          String    @id @default(uuid(7)) @db.Uuid
  tripId      String    @db.Uuid
  code        String    @unique
  createdById String    @db.Uuid
  revokedAt   DateTime?
  usesCount   Int       @default(0)
  createdAt   DateTime  @default(now())

  trip      Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([tripId])
}

/// Ordered stops of a trip ("Cracovie → Varsovie"). Empty while the destination is undecided.
model TripDestination {
  id       String @id @default(uuid(7)) @db.Uuid
  tripId   String @db.Uuid
  name     String
  position Int

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, position])
}

enum ParticipantRole {
  ORGANIZER
  PARTICIPANT
}

enum ParticipantStatus {
  ACTIVE
  LEFT
}

/// Membership of a trip. Everything inside a trip points to a participant, not a user, so that
/// guests (userId null) and people who left keep consistent data (docs/architecture.md §4).
model Participant {
  id             String            @id @default(uuid(7)) @db.Uuid
  tripId         String            @db.Uuid
  userId         String?           @db.Uuid
  displayName    String
  role           ParticipantRole   @default(PARTICIPANT)
  status         ParticipantStatus @default(ACTIVE)
  joinedAt       DateTime          @default(now())
  leftAt         DateTime?
  /// Guest participants (userId null): SHA-256 of their session token. Cleared when they leave or sign up.
  guestTokenHash String?           @unique

  trip  Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  ideas Idea[]

  @@unique([tripId, userId])
  @@index([userId])
}

enum IdeaCategory {
  ACTIVITY
  FOOD
  WALK
  BEACH
  CULTURE
  NIGHTLIFE
  OTHER
}

/// Indicative status (CDC §5). "Planned" is derived from a linked event, never stored.
enum IdeaStatus {
  PROPOSED
  KEPT
}

/// An entry of the trip's idea box. Only the title is required.
model Idea {
  id          String        @id @default(uuid(7)) @db.Uuid
  tripId      String        @db.Uuid
  authorId    String        @db.Uuid
  title       String
  category    IdeaCategory?
  place       String?
  url         String?
  description String?
  /// Free text: "Gratuit", "~25 € / pers.".
  cost        String?
  status      IdeaStatus    @default(PROPOSED)
  /// Bumped on every change; a PATCH made on an older version is refused (409).
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  trip   Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  /// Participants are only ever deleted with their trip.
  author Participant @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt])
  @@index([authorId])
}
