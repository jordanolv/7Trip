// 7Trip data model. The full V1 model is described in docs/architecture.md §4 and is added
// domain by domain, step by step (docs/roadmap.md).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum AvatarColor {
  sage
  sky
  sand
  peach
  lilac
  rose
  periwinkle
  stone
}

model User {
  id              String       @id @default(uuid(7)) @db.Uuid
  /// Always stored normalised (trimmed, lower case).
  email           String       @unique
  displayName     String
  /// Chosen in the profile; null: a colour derived from the id (defaultAvatarColor in @7trip/shared).
  avatarColor     AvatarColor?
  /// Argon2id hash. Null for accounts that only use Apple / Google sign-in.
  passwordHash    String?
  emailVerifiedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  refreshTokens RefreshToken[]
  emailCodes    EmailCode[]
  participants  Participant[]
  invitations   Invitation[]
  createdTrips  Trip[]
}

/// Opaque refresh tokens, stored hashed. Each one is single use (rotation on refresh).
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum EmailCodePurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Six-digit codes sent by email. Short lived, limited attempts, stored hashed.
model EmailCode {
  id         String           @id @default(uuid(7)) @db.Uuid
  userId     String           @db.Uuid
  purpose    EmailCodePurpose
  codeHash   String
  attempts   Int              @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

enum TripKind {
  SOLO
  GROUP
}

enum InvitePolicy {
  ALL
  ORGANIZERS
}

/// A trip. Only a title is required: destination and dates can be decided later (CDC §4).
model Trip {
  id           String       @id @default(uuid(7)) @db.Uuid
  title        String
  startDate    DateTime?    @db.Date
  endDate      DateTime?    @db.Date
  kind         TripKind     @default(GROUP)
  /// Key of the identity colour (see TRIP_COLORS in @7trip/shared).
  color        String
  /// Key of the identity icon (see TRIP_ICONS in @7trip/shared).
  icon         String
  invitePolicy InvitePolicy @default(ALL)
  baseCurrency String       @default("EUR")
  /// "Autre répartition": the reimbursements the group chose, [{ fromId, toId, amountMinor }].
  /// Only used while it still settles the balances in the fewest transfers (docs/decisions.md).
  transferPlan Json?
  createdById  String       @db.Uuid
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  createdBy    User              @relation(fields: [createdById], references: [id])
  participants Participant[]
  destinations TripDestination[]
  invitations  Invitation[]
  ideas        Idea[]
  events       Event[]
  polls        Poll[]
  expenses     Expense[]
  settlements  Settlement[]
}

/// Group invitation link of a trip (7trip.fr/j/<code>). One active link per trip; renewing it
/// revokes the old one. Joining always gives the PARTICIPANT role (docs/architecture.md §5).
model Invitation {
  id          String    @id @default(uuid(7)) @db.Uuid
  tripId      String    @db.Uuid
  code        String    @unique
  createdById String    @db.Uuid
  revokedAt   DateTime?
  usesCount   Int       @default(0)
  createdAt   DateTime  @default(now())

  trip      Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([tripId])
}

/// Ordered stops of a trip ("Cracovie → Varsovie"). Empty while the destination is undecided.
model TripDestination {
  id       String @id @default(uuid(7)) @db.Uuid
  tripId   String @db.Uuid
  name     String
  position Int

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, position])
}

enum ParticipantRole {
  ORGANIZER
  PARTICIPANT
}

enum ParticipantStatus {
  ACTIVE
  LEFT
}

/// Membership of a trip. Everything inside a trip points to a participant, not a user, so that
/// guests (userId null) and people who left keep consistent data (docs/architecture.md §4).
model Participant {
  id             String            @id @default(uuid(7)) @db.Uuid
  tripId         String            @db.Uuid
  userId         String?           @db.Uuid
  displayName    String
  /// Copied from the account, like displayName, and kept in sync when the profile changes.
  avatarColor    AvatarColor?
  role           ParticipantRole   @default(PARTICIPANT)
  status         ParticipantStatus @default(ACTIVE)
  joinedAt       DateTime          @default(now())
  leftAt         DateTime?
  /// Guest participants (userId null): SHA-256 of their session token. Cleared when they leave or sign up.
  guestTokenHash String?           @unique
  /// Ideas created after this, by others, are new to the participant (red badge on the Ideas tab).
  ideasSeenAt    DateTime?

  trip             Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  ideas            Idea[]
  events           Event[]
  eventMemberships EventParticipant[]
  polls            Poll[]             @relation("PollAuthor")
  closedPolls      Poll[]             @relation("PollCloser")
  votes            Vote[]
  expenses         Expense[]          @relation("ExpenseAuthor")
  paidExpenses     Expense[]          @relation("ExpensePayer")
  expenseShares    ExpenseShare[]
  budget           PersonalBudget?
  settlementsPaid  Settlement[]       @relation("SettlementFrom")
  settlementsGot   Settlement[]       @relation("SettlementTo")
  settlementsMade  Settlement[]       @relation("SettlementCreator")

  @@unique([tripId, userId])
  @@index([userId])
}

enum IdeaCategory {
  ACTIVITY
  FOOD
  WALK
  BEACH
  CULTURE
  NIGHTLIFE
  OTHER
}

/// Indicative status (CDC §5). "Planned" is derived from a linked event, never stored.
enum IdeaStatus {
  PROPOSED
  KEPT
}

/// An entry of the trip's idea box. Only the title is required.
model Idea {
  id          String        @id @default(uuid(7)) @db.Uuid
  tripId      String        @db.Uuid
  authorId    String        @db.Uuid
  title       String
  category    IdeaCategory?
  place       String?
  url         String?
  description String?
  /// Free text: "Gratuit", "~25 € / pers.".
  cost        String?
  status      IdeaStatus    @default(PROPOSED)
  /// Bumped on every change; a PATCH made on an older version is refused (409).
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  /// Participants are only ever deleted with their trip.
  author      Participant  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// Set once the idea is on the planning ("Planifiée" is derived from it).
  event       Event?
  pollOptions PollOption[]

  @@index([tripId, createdAt])
  @@index([authorId])
}

enum EventCategory {
  ACTIVITY
  FOOD
  TRANSPORT
  LODGING
  OTHER
}

/// An item of the planning (CDC §7). Dates and times are the trip's local ones, without timezone.
model Event {
  id          String        @id @default(uuid(7)) @db.Uuid
  tripId      String        @db.Uuid
  authorId    String        @db.Uuid
  /// The idea it was planned from: deleting the event keeps the idea, deleting the idea keeps the event.
  ideaId      String?       @unique @db.Uuid
  title       String
  category    EventCategory
  startDate   DateTime      @db.Date
  /// Last day of a multi-day event; null for a single day.
  endDate     DateTime?     @db.Date
  /// "18:00"; null for an event of the whole day.
  startTime   String?
  endTime     String?
  place       String?
  url         String?
  description String?
  bookingRef  String?
  /// Bumped on every change; a PATCH made on an older version is refused (409).
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  trip         Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  author       Participant        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  idea         Idea?              @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  /// None: the whole group.
  participants EventParticipant[]
  expenses     Expense[]

  @@index([tripId, startDate])
  @@index([authorId])
}

model EventParticipant {
  eventId       String @db.Uuid
  participantId String @db.Uuid

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@id([eventId, participantId])
  @@index([participantId])
}

enum PollKind {
  DESTINATION
  DATES
  LODGING
  FOOD
  ACTIVITY
  YES_NO
  OTHER
}

/// A poll of the trip (CDC §6). Closed once `closedAt` is set or `closesAt` is past; nothing is
/// decided from the results until an organizer applies an option.
model Poll {
  id              String    @id @default(uuid(7)) @db.Uuid
  tripId          String    @db.Uuid
  authorId        String    @db.Uuid
  kind            PollKind
  question        String
  multiple        Boolean   @default(false)
  closesAt        DateTime?
  closedAt        DateTime?
  /// Null when it closed on its own at the deadline.
  closedById      String?   @db.Uuid
  /// The option an organizer applied (destination set, idea kept…).
  appliedOptionId String?   @db.Uuid
  createdAt       DateTime  @default(now())

  trip     Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  author   Participant  @relation("PollAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  closedBy Participant? @relation("PollCloser", fields: [closedById], references: [id], onDelete: SetNull)
  options  PollOption[]

  @@index([tripId, createdAt])
  @@index([authorId])
  @@index([closedById])
}

model PollOption {
  id        String    @id @default(uuid(7)) @db.Uuid
  pollId    String    @db.Uuid
  label     String
  position  Int
  /// Options of a DATES poll: the range they propose.
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date
  /// The idea it stands for; the option keeps its label if the idea is deleted.
  ideaId    String?   @db.Uuid

  poll  Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  idea  Idea?  @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  votes Vote[]

  @@index([pollId, position])
  @@index([ideaId])
}

/// One line per chosen option: a single-choice poll has at most one per participant.
model Vote {
  optionId      String   @db.Uuid
  participantId String   @db.Uuid
  createdAt     DateTime @default(now())

  option      PollOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@id([optionId, participantId])
  @@index([participantId])
}

enum ExpenseCategory {
  FOOD
  ACTIVITY
  TRANSPORT
  LODGING
  GROCERIES
  SHOPPING
  OTHER
}

enum SplitMode {
  EQUAL
  CUSTOM
}

/// Amounts in integer minor units (cents) of `currency`, the trip's currency (docs/architecture.md §6).
model Expense {
  id              String           @id @default(uuid(7)) @db.Uuid
  tripId          String           @db.Uuid
  authorId        String           @db.Uuid
  payerId         String           @db.Uuid
  label           String
  /// As paid, in hundredths of `currency`.
  amountMinor     Int
  currency        String
  /// 1 unit of `currency` in the trip's currency, frozen when the expense is entered.
  rateToBase      Decimal          @default(1) @db.Decimal(20, 10)
  /// amountMinor converted: what the shares add up to, in the trip's currency.
  baseAmountMinor Int
  date            DateTime         @db.Date
  category        ExpenseCategory?
  /// Only its author sees it; it counts in their budget, never in the balances.
  personal        Boolean          @default(false)
  /// The planning item it was paid for (CDC §8.1); deleting the event keeps the expense.
  eventId         String?          @db.Uuid
  splitMode       SplitMode        @default(EQUAL)
  version         Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  trip   Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  author Participant    @relation("ExpenseAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  payer  Participant    @relation("ExpensePayer", fields: [payerId], references: [id], onDelete: Cascade)
  event  Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  shares ExpenseShare[]

  @@index([tripId, date])
  @@index([eventId])
  @@index([authorId])
  @@index([payerId])
}

/// Real share of an expense: what it costs this participant. The shares add up to the amount.
/// A participant's own forecast, seen only by them (CDC §8.3). Amounts in hundredths of `currency`.
model PersonalBudget {
  participantId String   @id @db.Uuid
  /// The trip's currency when it was set: a budget set before the trip's currency changed is set again.
  currency      String
  /// Null: only per category.
  totalMinor    Int?
  /// { FOOD: 18000, … }: a cap for some categories.
  perCategory   Json     @default("{}")
  updatedAt     DateTime @updatedAt

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model ExpenseShare {
  expenseId     String @db.Uuid
  participantId String @db.Uuid
  /// In the trip's currency: what counts in the balances and the budget.
  amountMinor   Int
  /// The same share in the expense's currency, as split or typed.
  originalMinor Int

  expense     Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@id([expenseId, participantId])
  @@index([participantId])
}

/// A reimbursement marked "C'est réglé": `from` paid `to`.
model Settlement {
  id          String   @id @default(uuid(7)) @db.Uuid
  tripId      String   @db.Uuid
  fromId      String   @db.Uuid
  toId        String   @db.Uuid
  amountMinor Int
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  trip      Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  from      Participant @relation("SettlementFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        Participant @relation("SettlementTo", fields: [toId], references: [id], onDelete: Cascade)
  createdBy Participant @relation("SettlementCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt])
  @@index([fromId])
  @@index([toId])
  @@index([createdById])
}
